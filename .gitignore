# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE
.idea/

# OS
.DS_Store
Thumbs.db

# Local git backup dumps (from destructive operations that copy the .git dir aside)
.git.bak-*/

# ---- Art asset heavy binaries ----
# Textures / models / audio inside art asset directories are kept out of the repo
# (体积大且换起来频繁). Materials / prefabs / shaders / scripts are still tracked so
# scene references survive on other machines even when the raw assets are missing.
# 如果需要接入这些资源，用团队约定的 OSS/网盘同步到对应目录即可。
/Assets/StylizedWater/**/*.png
/Assets/StylizedWater/**/*.jpg
/Assets/StylizedWater/**/*.jpeg
/Assets/StylizedWater/**/*.tga
/Assets/StylizedWater/**/*.psd
/Assets/StylizedWater/**/*.exr
/Assets/StylizedWater/**/*.hdr
/Assets/StylizedWater/**/*.fbx
/Assets/StylizedWater/**/*.FBX
/Assets/StylizedWater/**/*.obj
/Assets/StylizedWater/**/*.blend
/Assets/StylizedWater/**/*.wav
/Assets/StylizedWater/**/*.mp3
/Assets/StylizedWater/**/*.ogg
/Assets/StylizedWater/**/*.pdf

/Assets/StylizedWaterShader/**/*.png
